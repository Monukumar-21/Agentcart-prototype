RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

MOCK_MODE=true

PORT=8000

MAX_AUTO_APPROVE_RUPEES=2000.00
MAX_ACTIONS_PER_MINUTE=5

MAX_RETRIES=2
RETRY_BASE_DELAY_SECONDS=0.3

# Fraction (0.0 - 1.0) — makes the mock Razorpay client randomly fail,
# useful for testing the retry + graceful-failure path.
MOCK_FAILURE_RATE=0.0
