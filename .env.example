# Copy to .env and fill in your Razorpay TEST MODE keys.
# Get them from: Razorpay Dashboard -> Settings -> API Keys -> Generate Test Key
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# If unset, empty, or "true", the app runs in MOCK MODE: it simulates
# Razorpay responses locally, so you can test the full guardrails ->
# policy -> orchestrator -> audit flow with zero setup.
MOCK_MODE=true

PORT=8000

# Policy engine bounds
MAX_AUTO_APPROVE_PAISE=200000
MAX_ACTIONS_PER_MINUTE=5

# Error/retry tracing
MAX_RETRIES=2
RETRY_BASE_DELAY_SECONDS=0.3

# Set to a fraction (0.0 - 1.0) to make the mock Razorpay client randomly
# fail, so you can watch the retry + graceful-failure path in the dashboard.
MOCK_FAILURE_RATE=0.0
